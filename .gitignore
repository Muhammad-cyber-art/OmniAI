# OmniLab AI - Root .gitignore

# ── Byte-compiled / optimized / DLL files ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# ── Django / Static & Media ───────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3-journal
media/
staticfiles/
backend/media/
backend/staticfiles/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ── Node / Frontend (if build occurs in root) ─────────────────────────────────
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDEs, Editors & OS Files ──────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
